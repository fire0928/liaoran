/* 了然小程序 - 测评答题页 */
.questions-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: var(--color-bg);
}

.q-header {
  padding: 32rpx;
  background: var(--color-primary-light);
  border-radius: 0 0 40rpx 40rpx;
}

.progress-section {
  padding: 24rpx 32rpx;
}
.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 12rpx;
  border-radius: 12rpx;
  background: var(--color-border-light);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  transition: width 0.3s ease;
}

.question-card {
  margin: 0 24rpx 24rpx;
  padding: 40rpx 32rpx;
}
.question-text {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.7;
  display: block;
  margin-bottom: 40rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 2px solid var(--color-border);
  background: var(--color-surface);
  transition: all 0.2s;
}
.option-item.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}
.option-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2px solid var(--color-border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.option-item.selected .option-radio {
  border-color: var(--color-primary);
}
.option-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
.option-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex: 1;
}

.q-nav {
  padding: 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
}
.q-nav .btn-outline {
  flex: 1;
  padding: 24rpx 20rpx;
  text-align: center;
  border-radius: 24rpx;
  border: 2px solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  font-size: 28rpx;
}
.q-nav .btn-primary {
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.q-nav .btn-primary[disabled] {
  opacity: 0.4;
}
