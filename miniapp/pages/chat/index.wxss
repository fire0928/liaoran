.chat-page { display: flex; flex-direction: column; height: 100vh; background: var(--color-bg); }

.chat-header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 32rpx; background: var(--color-surface);
  border-bottom: 1px solid var(--color-border-light);
}
.chat-agent-avatar {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  background: var(--color-primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
}

.chat-messages {
  flex: 1; padding: 24rpx; overflow-y: auto;
}
.msg-row { margin-bottom: 24rpx; display: flex; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }
.msg-bubble {
  max-width: 80%; padding: 20rpx 28rpx;
  border-radius: 36rpx; font-size: 28rpx; line-height: 1.6;
}
.bubble-user {
  background: var(--color-primary-light);
  border-bottom-right-radius: 8rpx;
}
.bubble-ai {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-bottom-left-radius: 8rpx;
}

.chat-input-area {
  display: flex; gap: 16rpx; padding: 20rpx 24rpx;
  background: var(--color-surface); border-top: 1px solid var(--color-border-light);
}
.chat-input {
  flex: 1; height: 72rpx; padding: 0 28rpx;
  border-radius: 44rpx; background: var(--color-surface-warm);
  font-size: 28rpx; border: none;
}
.send-btn {
  width: 140rpx; height: 72rpx; border-radius: 44rpx;
  background: var(--color-primary); color: #fff;
  font-size: 26rpx; text-align: center; line-height: 72rpx;
  border: none; padding: 0;
}
.send-btn[disabled] { opacity: 0.5; }
