.page { padding-bottom: 48rpx; }

.treehole-banner {
  margin: 24rpx; padding: 48rpx 32rpx;
  border-radius: 40rpx; text-align: center;
  background: var(--color-secondary-light);
}
.anonymous-badge {
  margin-top: 16rpx; display: inline-block;
  padding: 12rpx 28rpx; border-radius: 40rpx;
  background: rgba(107,175,158,0.15); color: var(--color-secondary);
  font-size: 24rpx;
}

.treehole-list { padding: 0 24rpx; }
.anon-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--color-surface-warm);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.mood-tag {
  display: inline-block; margin-top: 12rpx;
  padding: 6rpx 20rpx; border-radius: 16rpx;
  background: var(--color-surface-warm);
  font-size: 24rpx; color: var(--color-text-tertiary);
}

.composer-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3); display: flex;
  align-items: center; justify-content: center; z-index: 1000;
}
.composer-dialog {
  width: 85%; padding: 48rpx;
  background: var(--color-surface); border-radius: 40rpx;
}
.composer-textarea {
  width: 100%; min-height: 200rpx; padding: 20rpx;
  border-radius: 24rpx; background: var(--color-surface-warm);
  font-size: 28rpx;
}
